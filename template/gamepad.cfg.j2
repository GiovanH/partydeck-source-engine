{{ bind_engine("+jump", ("A_BUTTON", "JOY1")) }}
{{ bind_engine("+duck", ("B_BUTTON", "JOY2")) }}
{{ bind_engine("+reload", ("X_BUTTON", "JOY3")) }}
{{ bind_engine("+use", ("Y_BUTTON", "JOY4")) }}

{{ bind_all("+showscores", ("BACK", "JOY7", "AUX5")) }}
{{ bind_all("pause",  ("START", "JOY8", "AUX7")) }}

{{ bind_engine("invprev", ("LEFT", "AUX14")) }}
{{ bind_engine("invnext", ("RIGHT", "AUX15")) }}
