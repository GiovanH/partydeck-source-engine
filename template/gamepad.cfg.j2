{#- "goldsrc" or "source" #}
{%- set MOD = MOD | default("hl2") %}
{%- set ENGINE = ENGINE | default("source") %}

{%- macro bind_engine(action, values, bind="bind") %}
{%- set i = ["source", "goldsrc"].index(ENGINE) -%}
{{bind}} {{ values[i] }} {{ action }}
{%- endmacro -%}

{%- macro bind_all(action, values) %}
{%- for v in values %}
bind {{ v }} {{ action }}
{%- endfor -%}
{%- endmacro -%}

joystick "1"

