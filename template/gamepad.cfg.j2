{{ bind_engine("lastinv", ("POV_DOWN", "AUX13")) }}

{{ bind_engine("invprev", ("POV_LEFT", "AUX14")) }}
{{ bind_engine("invnext", ("POV_RIGHT", "AUX15")) }}

