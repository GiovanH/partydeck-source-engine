{{ bind_engine('"impulse 100"', ("STICK1", "AUX8")) }}

{%- if ENGINE == "source" %}
{{ bind_engine("toggle_zoom", ("STICK2", "AUX99")) }}
{% endif %}

{%- if ENGINE == "source" %}

// Source engine: triggers and shoulders

{{ bind_engine("lastinv", ("L_SHOULDER", "AUX10")) }}
{{ bind_engine("+attack2", ("R_SHOULDER", "AUX11")) }}
{{ bind_engine("+speed", ("L_TRIGGER", "AUX99")) }}
{{ bind_engine("+attack", ("R_TRIGGER", "AUX11")) }}

{%- elif ENGINE == "goldsrc" %}

// Goldsrc: no triggers, only shoulders

{{ bind_engine("+attack2", ("L_SHOULDER", "AUX10")) }}
{{ bind_engine("+attack", ("R_SHOULDER", "AUX11")) }}

{%- else %}

// Unhandled engine {{ENGINE}}

{%- endif %}

