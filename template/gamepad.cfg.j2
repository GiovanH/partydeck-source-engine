{%- set MOD = MOD | default("hl2") %}
{%- set ENGINE = ENGINE | default("goldsrc" if MOD == "hl" else "source") %}

{#- features #}
{%- set ZOOM = ZOOM | default(ENGINE == "source") %}
{%- set PHYS_SWAP = PHYS_SWAP | default(MOD in ("hl2",)) %}
{%- set FLASHLIGHT = FLASHLIGHT | default(False) %}
{%- set CHANGECLASS = CHANGECLASS | default(False) %}

{%- set DEBUG_ECHO = DEBUG_ECHO | default(False) %}

{%- macro crepr(action, key) -%}
{%- set action = (('echo ' + key + '; ' + action) if key and DEBUG_ECHO else action) -%}
{%- set action = ('"' + action + '"' if (" " in action) else action) -%}
{{action}}
{%- endmacro -%}

{%- macro bindk(action, key, bind="bind") %}
{%- set action = crepr(action, key) -%}
{%- if "+" in action -%}
alias +al_{{key}} {{action}}
alias -al_{{key}} {{action|replace("+", "-")}}
{{bind}} {{key}} +al_{{key}}
{%- else -%}
{{bind}} {{key}} {{action}}
{%- endif -%}
{%- endmacro -%}

{#- bind action with source or goldsrc name #}
{%- macro bind_engine(action, values, bind="bind") %}
{%- set i = ["source", "goldsrc"].index(ENGINE) -%}
{{ bindk(action, values[i], bind) }}
{%- endmacro -%}

{#- try all names #}
{%- macro bind_all(action, values) %}
{%- for v in values %}
{{ bindk(action, v) }}
{%- endfor -%}
{%- endmacro -%}

// PartyDeck gamepad.cfg for {{ MOD }} ({{ ENGINE}})
// ZOOM={{ZOOM}}
// FLASHLIGHT={{FLASHLIGHT}}
